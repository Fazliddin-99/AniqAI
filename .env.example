# Шаблон переменных окружения. Скопируйте в .env и заполните:
#   cp .env.example .env        (или в PowerShell: Copy-Item .env.example .env)
# .env в .gitignore — секреты в git не попадают. РЕАЛЬНЫЕ токены/ключи — только в .env!
# Один корневой .env читается всеми процессами (мок 1С, бэкенд, бот).

# --- Claude / LLM ---
ANTHROPIC_API_KEY=sk-ant-...
# LLM_PROVIDER=anthropic                       # anthropic (по умолчанию) | openai (локальная модель)
# LOCAL_LLM_URL=http://localhost:8001/v1
# LOCAL_LLM_MODEL=Qwen/Qwen2.5-VL-32B-Instruct

# --- 1С (dev: мок). Реальные подключения компаний теперь в БД (админка) ---
ONEC_BASE_URL=http://localhost:8100            # используется сид-скриптом демо-компании

# --- Шифрование учётных данных 1С в БД (Fernet-ключ) ---
# Сгенерировать: uv run python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=

# --- Веб-админка (управление компаниями и пользователями) ---
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-too-long-random

# --- Telegram-бот ---
BOT_TOKEN=8123456789:AAH...                    # реальный токен вписывайте в .env, не сюда
BACKEND_URL=http://localhost:8000
# BOT_WHITELIST больше не используется — доступ управляется в админке (БД).
# Первого пользователя завести: uv run python -m app.db.seed  (SEED_TELEGRAM_ID=...)

# --- Демо-режим (по умолчанию выключен): любой пользователь Telegram
# авторегистрируется в компанию DEMO_COMPANY_ID при первом сообщении.
# На проде не включать — доступ только по whitelist'у админки.
# DEMO_AUTO_REGISTER=1
# DEMO_COMPANY_ID=1
