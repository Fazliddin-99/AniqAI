# Шаблон переменных окружения. Скопируйте в .env и заполните:
#   cp .env.example .env        (или в PowerShell: Copy-Item .env.example .env)
# .env в .gitignore — секреты в git не попадают.
# Один корневой .env читается всеми тремя процессами (мок 1С, бэкенд, бот).

# --- Claude / LLM ---
ANTHROPIC_API_KEY=sk-ant-...
# LLM_PROVIDER=anthropic                       # anthropic (по умолчанию) | openai (локальная модель)
# LOCAL_LLM_URL=http://localhost:8001/v1
# LOCAL_LLM_MODEL=Qwen/Qwen2.5-VL-32B-Instruct

# --- 1С (dev: мок) ---
ONEC_BASE_URL=http://localhost:8100
# ONEC_USER=
# ONEC_PASSWORD=

# --- Telegram-бот ---
BOT_TOKEN=8123456789:AAH...
BACKEND_URL=http://localhost:8000
BOT_WHITELIST=ВАШ_TELEGRAM_ID:demo            # id:компания, несколько через запятую
